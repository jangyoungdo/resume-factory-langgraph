OPENAI_API_KEY=
RF_BACKEND=codex
RF_MODEL_LUNA=gpt-5.6-luna
RF_MODEL_TERRA=gpt-5.6-terra
RF_MODEL_SOL=gpt-5.6-sol
RF_EXECUTION_MODE=balanced
RF_EMBEDDING_MODEL=BAAI/bge-m3
RF_DUAL_BRAIN_ROOT=/absolute/path/to/your/private/vault
RF_NOTION_TOKEN=
RF_NOTION_SNAPSHOT_DIR=/absolute/path/to/private/notion-snapshots
RF_MLFLOW_TRACKING_URI=sqlite:///.local/mlflow.db
RF_ENABLE_MLFLOW=false
RF_CODEX_MAX_CONCURRENCY=2
RF_CODEX_TIMEOUT_SECONDS=180
